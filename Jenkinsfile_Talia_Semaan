pipeline {
    agent any

    environment {
        VIRTUAL_ENV = 'venv'
    }

    stages {
        stage('Setup') {
            steps {
                bat '''
                    python -m venv "%VIRTUAL_ENV%"
                    "%VIRTUAL_ENV%\\Scripts\\python.exe" -m pip install --upgrade pip
                    "%VIRTUAL_ENV%\\Scripts\\python.exe" -m pip install -r requirements.txt
                '''
            }
        }

        stage('Lint') {
            steps {
                bat '''
                    "%VIRTUAL_ENV%\\Scripts\\flake8.exe" app.py tests
                '''
            }
        }

        stage('Test') {
            steps {
                bat '''
                    "%VIRTUAL_ENV%\\Scripts\\pytest.exe"
                '''
            }
        }

        stage('Coverage') {
            steps {
                bat '''
                    "%VIRTUAL_ENV%\\Scripts\\coverage.exe" erase
                    "%VIRTUAL_ENV%\\Scripts\\coverage.exe" run -m pytest
                    "%VIRTUAL_ENV%\\Scripts\\coverage.exe" report -m
                    "%VIRTUAL_ENV%\\Scripts\\coverage.exe" html
                '''
            }
        }

        stage('Security Scan') {
            steps {
                bat '''
                    "%VIRTUAL_ENV%\\Scripts\\bandit.exe" -r app.py tests
                '''
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                    "%VIRTUAL_ENV%\\Scripts\\python.exe" deploy.py
                '''
            }
        }
    }
}
